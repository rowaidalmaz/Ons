# Public Supabase project values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never send to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Pepper used to HMAC-hash the anonymous community-post author id server-side.
# Generate with: openssl rand -hex 32
POST_AUTHOR_PEPPER=
